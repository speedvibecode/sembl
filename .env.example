NEXT_PUBLIC_SUPABASE_URL=https://djquuvkwnjpweubzrsnn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key

# Server-only Postgres connection used by the durable Sembl backend.
SUPABASE_DB_URL=postgresql://postgres.<project_ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Optional server default. The UI also accepts a per-session key for AI graph analysis.
OPENAI_API_KEY=

# Optional server-only factory provider credentials. Required only for GitHub export
# and Vercel deployment actions; generated artifact download works without them.
GITHUB_TOKEN=
SEMBL_FACTORY_GITHUB_OWNER=
SEMBL_FACTORY_GITHUB_PRIVATE=true
VERCEL_TOKEN=
SEMBL_FACTORY_VERCEL_TEAM_ID=
SEMBL_FACTORY_VERCEL_PROJECT_PREFIX=sembl-build

# Optional Playwright authenticated workflow credentials.
SEMBL_E2E_EMAIL=
SEMBL_E2E_PASSWORD=
