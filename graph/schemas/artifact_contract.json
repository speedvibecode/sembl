{
  "schema_version": "sembl.v4_3.artifact_contract.v1",
  "graph_node": {
    "required": ["id", "node_type", "name", "payload", "source_spec_type", "source_refs"],
    "allowed_node_types": ["entity", "interface", "integration_contract", "flow", "invariant", "execution_boundary"]
  },
  "graph_edge": {
    "required": ["id", "edge_type", "source_node_id", "target_node_id", "metadata"],
    "allowed_edge_types": ["dependency", "implements", "precedes", "triggers", "owns", "lineage"]
  },
  "task_node": {
    "required": ["id", "name", "agent", "model_policy", "dependencies", "graph_scope", "expected_outputs", "validation_gates", "packet"]
  },
  "validation_violation": {
    "required": ["invariant_id", "severity", "affected_structure", "reason", "graph_location", "source_ref"]
  }
}
