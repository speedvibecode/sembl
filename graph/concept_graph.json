  "integration_contracts": [
    {
      "id": "contract.new_project_to_validated_graph",
      "name": "NewProjectToValidatedGraph",
      "steps": [
        {
          "interface": "CreateWorkspace",
          "input_mapping": {
            "name": "intent.workspace_name",
            "actor_id": "session.user_id"
          }
        },
        {
          "interface": "CreateProject",
          "input_mapping": {
            "workspace_id": "CreateWorkspace.output.workspace.id",
            "name": "intent.project_name",
            "actor_id": "session.user_id"
          }
        },
        {
          "interface": "PublishSpecificationRevision",
          "input_mapping": {
            "project_id": "CreateProject.output.project.id",
            "spec_type": "intent.spec_type",
            "content": "intent.spec_content",
            "actor_id": "session.user_id"
          }
        },
        {
          "interface": "ConstructConceptGraph",
          "input_mapping": {
            "project_id": "CreateProject.output.project.id",
            "revision_ids": "PublishSpecificationRevision.output.revision.id"
          }
        },
        {
          "interface": "NormalizeGraph",
          "input_mapping": {
            "concept_graph_id": "ConstructConceptGraph.output.graph_version.id",
            "ui_graph_id": "locked_design_artifact.id"
          }
        },
        {
          "interface": "ValidateGraph",
          "input_mapping": {
            "graph_version_id": "NormalizeGraph.output.graph_version.id"
          }
        }
      ],
      "error_handling": ["Stop at first blocking validation failure.", "Persist graph-addressable violation output.", "Route ambiguity to human review."],
      "transaction": {
        "atomic": false,
        "rollback": "immutable_revision_and_event_lineage_are_preserved"
      },
      "source_refs": ["v_4.3.md#docs-concept-graph-normalized-graph", "prd.md#canonical-product-flow"]
    },
    {
      "id": "contract.validated_graph_to_execution",
      "name": "ValidatedGraphToExecution",
      "steps": [
        {
          "interface": "GenerateTaskGraph",
          "input_mapping": {
            "graph_version_id": "ValidateGraph.input.graph_version_id"
          }
        },
        {
          "interface": "RequestExecutionApproval",
          "input_mapping": {
            "branch_id": "active_branch.id",
            "impact_payload": "GenerateTaskGraph.output.impact_payload"
          }
        },
        {
          "interface": "StartExecution",
          "input_mapping": {
            "branch_id": "active_branch.id",
            "approval_id": "RequestExecutionApproval.output.approval.id"
          }
        },
        {
          "interface": "ReconcileExecutionOutput",
          "input_mapping": {
            "execution_run_id": "StartExecution.output.execution_run.id"
          }
        }
      ],
      "error_handling": ["Manual execution requires a valid non-expired approval.", "Retry is bounded to three lineage attempts.", "Non-convergence escalates."],
      "transaction": {
        "atomic": false,
        "rollback": "reconciliation_rollback_records_lineage_without_mutating_prior_graph_versions"
      },
      "source_refs": ["api_spec.md#execution", "prd.md#execution-behavior"]
    },
    {
      "id": "contract.provider_preflight",
      "name": "ProviderPreflight",
      "steps": [
        {
          "interface": "ConnectWorkspaceIntegration",
          "input_mapping": {
            "workspace_id": "workspace.id",
            "provider": "github"
          }
        },
        {
          "interface": "ConnectWorkspaceIntegration",
          "input_mapping": {
            "workspace_id": "workspace.id",
            "provider": "vercel"
          }
        }
      ],
      "error_handling": ["Do not commit provider secrets.", "Record provider metadata only.", "Use fresh isolated Supabase branch/project for this attempt."],
      "transaction": {
        "atomic": false,
        "rollback": "unlink_provider_metadata_without_deleting_external_artifacts"
      },
      "source_refs": ["api_spec.md#workspace-integrations", "techarch.md#github", "techarch.md#vercel"]
    }
  ],
  "flows": [
    {
      "id": "flow.documentation_mode",
      "name": "DocumentationModeFlow",
      "integration_contract_ids": ["contract.new_project_to_validated_graph"],
      "source_refs": ["prd.md#documentation-mode", "uiux.md#documentation-mode"]
    },
    {
      "id": "flow.execution_mode",
      "name": "ExecutionModeFlow",
      "integration_contract_ids": ["contract.validated_graph_to_execution"],
      "source_refs": ["prd.md#execution-mode", "uiux.md#execution-mode"]
    },
    {
      "id": "flow.provider_wiring",
      "name": "ProviderWiringFlow",
      "integration_contract_ids": ["contract.provider_preflight"],
      "source_refs": ["techarch.md#external-runtime-dependencies", "api_spec.md#workspace-integrations"]
    }
  ],
  "invariants": [
    {
      "id": "G1",
      "name": "GraphSelfContained",
      "rule": "Every graph reference resolves inside the graph or to an explicit source document reference.",
      "scope": "graph",
      "severity": "blocking",
      "source_refs": ["v_4.3.md#graph-invariants", "nfr.md#graph-integrity-constraint"]
    },
    {
      "id": "G2",
      "name": "ApprovedNodeTypesOnly",
      "rule": "Normalized graph nodes must use only entity, interface, integration_contract, flow, invariant, and execution_boundary.",
      "scope": "normalized_graph",
      "severity": "blocking",
      "source_refs": ["systemdesign.md#canonical-graph-structures", "db_schema.md#graph_nodes"]
    },
    {
      "id": "G3",
      "name": "NoDuplicateStructures",
      "rule": "Canonical graph structures must not duplicate names or semantic responsibilities within the same node type.",
      "scope": "graph",
      "severity": "blocking",
      "source_refs": ["v_4.3.md#normalization-strict", "prd.md#graph-validation"]
    },
    {
      "id": "I1",
